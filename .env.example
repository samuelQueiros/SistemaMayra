# Copie para .env e preencha os valores reais. Nunca commitar o .env.

ENV=development

# Backend / banco de dados
DATABASE_URL=postgresql://usuario:senha@localhost:5432/formpsico
# Em desenvolvimento local, SQLite é aceitável:
# DATABASE_URL=sqlite:///./dev.db

# Só usadas pelo docker-compose.yml (deploy em VPS via Docker Compose —
# ver DEPLOY.md seção 3). Se você não for usar o docker-compose, ignore
# estas duas.
POSTGRES_PASSWORD=troque-por-uma-senha-forte
DOMAIN=laudos.suaclinica.com.br

# Em produção (ENV=production) o sistema NÃO sobe com este valor de exemplo:
# gere um com `openssl rand -hex 32`. Para a VPS, use scripts/gerar-env.sh.
JWT_SECRET=troque-por-um-segredo-forte
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440

# Login da psicóloga criado/atualizado a cada start do container (opcional,
# ver backend/app/seed_admin.py). Trocar ADMIN_PASSWORD e reiniciar
# redefine a senha.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cadastro público de contas (/api/auth/register). Vazio = ligado em
# desenvolvimento e DESLIGADO em produção. Só ligue se precisar.
ALLOW_REGISTRATION=

# IA (via LangChain) — provedor configurável, ver SPEC.md seção 5.
# Cada psicóloga também pode configurar sua própria chave direto pela
# tela "Configurações" do sistema — o que estiver aqui serve só de
# reserva/padrão do servidor.
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Storage de arquivos (fotos de pacientes, PDFs gerados) — opcional.
# Sem preencher nada aqui, tudo fica salvo em disco local
# (backend/storage/...), como sempre foi. Preenchendo S3_BUCKET, passa a
# usar um bucket compatível com S3 (AWS, Cloudflare R2, Backblaze B2...) —
# ver DEPLOY.md.
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
