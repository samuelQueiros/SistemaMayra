{$DOMAIN} {
	# Caddy emite e renova o certificado HTTPS sozinho (Let's Encrypt) —
	# não precisa configurar nada além do domínio apontando pra esta VPS.
	reverse_proxy app:8000

	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
	}
}
