# Variáveis da stack do Portainer (docker-compose.portainer.yml).
# No Portainer: Stacks > Add stack > Environment variables >
# "Load variables from .env file" e escolha uma cópia preenchida deste
# arquivo. NUNCA commitar a cópia preenchida.

# Obrigatórias
POSTGRES_PASSWORD=troque-por-uma-senha-forte
JWT_SECRET=gere-com-openssl-rand-hex-32
# Domínio com registro DNS tipo A já apontando para o IP da VPS
DOMAIN=laudos.suaclinica.com.br

# Login da psicóloga — criado no primeiro start. Trocar ADMIN_PASSWORD e
# reiniciar a stack redefine a senha. Senha: mínimo 8 caracteres.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Imagem (o valor abaixo já é o padrão da stack)
APP_IMAGE=ghcr.io/samuelqueiros/psicologa:latest

# Login
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440

# IA (opcional — cada psicóloga também pode configurar a própria chave
# pela tela "Configurações")
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Storage S3 (opcional — vazio = arquivos no volume app_storage)
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
